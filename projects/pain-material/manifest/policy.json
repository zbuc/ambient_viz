{
  "schema": "policy.v1",
  "project": "pain-material",
  "authorityLadder": {
    "safety": 1000,
    "manual_blackout": 900,
    "local_ui": 700,
    "timeline": 500,
    "clock": 400,
    "sensor": 300,
    "idle": 100
  },
  "roles": [
    {
      "name": "sensor_node",
      "canPublish": ["sensor.${instance}.*", "touch.${instance}.*", "device.${instance}.*"],
      "cannotPublish": ["clock.*", "safety.*", "transport.*"],
      "canSubscribe": [],
      "maxPriority": 300
    },
    {
      "name": "clock_source",
      "canPublish": ["clock.${instance}.*", "device.${instance}.*"],
      "cannotPublish": ["safety.*"],
      "canSubscribe": ["fx.*"],
      "maxPriority": 400
    },
    {
      "name": "local_ui",
      "canPublish": ["ui.${instance}.*"],
      "cannotPublish": ["clock.*", "safety.*", "sensor.*"],
      "canSubscribe": ["sensor.*", "touch.*", "clock.*", "ui.*"],
      "maxPriority": 700
    },
    {
      "name": "router",
      "canPublish": ["fx.*"],
      "cannotPublish": ["clock.*", "safety.*", "sensor.*", "touch.*", "ui.*", "transport.*"],
      "canSubscribe": ["sensor.*", "touch.*", "clock.*", "ui.*", "timeline.*"],
      "maxPriority": 300
    },
    {
      "name": "occupancy_router",
      "canPublish": ["derived.room.*"],
      "cannotPublish": ["clock.*", "safety.*", "sensor.*", "touch.*", "ui.*", "transport.*", "fx.*", "seq.*"],
      "canSubscribe": ["sensor.*", "touch.*", "clock.*"],
      "maxPriority": 300
    },
    {
      "name": "plugin_host",
      "canPublish": ["seq.*"],
      "cannotPublish": ["clock.*", "safety.*", "sensor.*", "touch.*", "ui.*", "transport.*", "fx.*"],
      "canSubscribe": ["sensor.*", "touch.*", "clock.*", "ui.*", "timeline.*", "fx.*"],
      "maxPriority": 300
    },
    {
      "name": "defaults",
      "canPublish": ["sensor.door.near_cm", "sensor.door.far_cm", "sensor.room.motion"],
      "cannotPublish": ["clock.*", "safety.*", "transport.*"],
      "canSubscribe": [],
      "maxPriority": 100
    }
  ],
  "allow": [
    { "stableId": "spiffe://pain-material.local/sidecar/tof-door", "role": "sensor_node", "instanceId": "door" },
    { "stableId": "spiffe://pain-material.local/sidecar/am312-room", "role": "sensor_node", "instanceId": "room" },
    { "stableId": "spiffe://pain-material.local/sidecar/hr202-breath", "role": "sensor_node", "instanceId": "breath" },
    { "stableId": "spiffe://pain-material.local/sidecar/mpr121-pad0", "role": "sensor_node", "instanceId": "pad0" },
    { "stableId": "spiffe://pain-material.local/daisy/serial", "role": "clock_source", "instanceId": "daisy" },
    { "stableId": "spiffe://pain-material.local/browser/ui", "role": "local_ui", "instanceId": "browser" },
    { "stableId": "spiffe://pain-material.local/bridge/router", "role": "router", "instanceId": "main" },
    { "stableId": "spiffe://pain-material.local/bridge/plugin-host", "role": "plugin_host", "instanceId": "plugins" },
    { "stableId": "spiffe://pain-material.local/bridge/router-occupancy", "role": "occupancy_router", "instanceId": "occupancy" },
    { "stableId": "spiffe://pain-material.local/bridge/defaults", "role": "defaults", "instanceId": "defaults" }
  ],
  "groups": [],
  "runtimeModes": {
    "auth": "WARN",
    "signature": "NONE",
    "priority": "WARN",
    "timeSync": "OFF"
  }
}

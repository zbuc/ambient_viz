{
  "schema": "manifest.v1",
  "identity": {
    "stableId": "spiffe://pain-material.local/sidecar/tof-door",
    "instanceId": "door",
    "humanLabel": "Door ToF distance (VL53L1X/L5CX via sidecar)",
    "type": "vl53-distance-node",
    "firmwareVersion": "sidecar",
    "schemaVersion": "manifest.v1"
  },
  "role": "sensor_node",
  "publishes": [
    { "path": "sensor.door.distance_cm", "valueType": "VALUE_TYPE_FLOAT", "shape": "SHAPE_STATE", "unit": "cm",
      "range": { "min": 0, "max": 400 }, "nominalRateHz": 30, "maxRateHz": 60,
      "interpolation": "INTERPOLATION_LINEAR", "staleAfterMs": 2000, "onStale": "ON_STALE_HOLD" },
    { "path": "sensor.door.velocity_cm_s", "valueType": "VALUE_TYPE_FLOAT", "shape": "SHAPE_STATE", "unit": "cm_s",
      "range": { "min": -400, "max": 400 }, "nominalRateHz": 30, "maxRateHz": 60,
      "interpolation": "INTERPOLATION_LINEAR", "staleAfterMs": 2000, "onStale": "ON_STALE_HOLD" },
    { "path": "sensor.door.near_cm", "valueType": "VALUE_TYPE_FLOAT", "shape": "SHAPE_STATE", "unit": "cm",
      "range": { "min": 0, "max": 400 }, "nominalRateHz": 0.5, "maxRateHz": 2,
      "interpolation": "INTERPOLATION_STEP", "staleAfterMs": 10000, "onStale": "ON_STALE_HOLD" },
    { "path": "sensor.door.far_cm", "valueType": "VALUE_TYPE_FLOAT", "shape": "SHAPE_STATE", "unit": "cm",
      "range": { "min": 0, "max": 400 }, "nominalRateHz": 0.5, "maxRateHz": 2,
      "interpolation": "INTERPOLATION_STEP", "staleAfterMs": 10000, "onStale": "ON_STALE_HOLD" }
  ],
  "subscribes": []
}
